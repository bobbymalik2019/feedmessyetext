    {
      "id": "tbMeG4MY1KjwPCizKG-Ly",
      "type": "text",
      "x": -6.152836390904099,
      "y": 5701.892820085797,
      "width": 1390.7057059151784,
      "height": 36.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
