    {
      "id": "NpqdzgqSMXnyYqu45CenK",
      "type": "text",
      "x": 218.5570575169154,
      "y": 3645.0714220319464,
      "width": 1073.857067653111,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
